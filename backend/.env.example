# ============================ Universal Platform — backend ============================
# Copy to .env and adjust. The app also runs with sensible defaults (local Postgres).

# PostgreSQL DSN for the platform database.
DATABASE_URL=postgresql://postgres:linux@localhost:5432/ucap_platform

# Secret used to sign login tokens. CHANGE THIS IN PRODUCTION.
AUTH_SECRET=dev-secret-change-me
TOKEN_TTL_SECONDS=604800

# HTTP server
APP_HOST=127.0.0.1
APP_PORT=8000

# Enable the built-in sensor simulator (generates readings for instances
# whose config.simulate is true). Set to 0 in production.
ENABLE_SIMULATOR=1

# Demo customer database + API credentials (ucap_customer_corp).
# Simulates "the customer's own server + database". init_db.py creates the DB.
CUSTOMER_DEMO_DATABASE_URL=postgresql://postgres:linux@localhost:5432/ucap_customer_corp
CUSTOMER_DEMO_API_KEY=demo-customer-key
CUSTOMER_DEMO_API_SECRET=demo-customer-secret

# Gmail OAuth email alerts. Create an OAuth 2.0 Client ID (Web application) in
# Google Cloud Console and add the redirect URI shown in the Email alerts panel.
# It defaults to PUBLIC_BASE_URL + /api/v1/email-alerts/oauth-callback, e.g.
#   http://127.0.0.1:8000/api/v1/email-alerts/oauth-callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Override only when the public URL or callback path differs.
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/email-alerts/oauth-callback
# Where per-company settings and Gmail tokens are written (gitignored).
# Defaults to backend/data/email_alerts when unset.
# EMAIL_ALERT_DATA_DIR=data/email_alerts
